meta {
  name: Update Password
  type: http
  seq: 7
}

put {
  url: {{baseUrl}}/users/me/password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "currentPassword": "securepassword123",
    "newPassword": "newsecurepassword456"
  }
}
