meta {
  name: Change Password
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/change-password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "currentPassword": "securepassword123",
