meta {
  name: Get Pre-Signed URL
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/media/presigned-url
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{token}}
}

body:json {
  {
    "filename": "site_photo_1.jpg",
    "contentType": "image/jpeg",
    "bucketType": "property-image"
  }
}
